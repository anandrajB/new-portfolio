---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Anand Raj" description="About Anand Raj Lorem Ipsum">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline=""
			>
				
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I started my career at DESSS Applying Technologies, where I built automated web scraping solutions, data extraction systems, and microservices. This role provided me with a strong foundation in backend engineering, scalable system design, and robust API development. 
					</p>
					<p>
					Moving forward, I joined Venzo Technologies to architect and maintain multiple complex products across the fintech and edtech sectors—including lending management systems and enterprise learning platforms. My responsibilities expanded across the entire stack, leveraging Python (Django, FastAPI), React, and AWS to build secure, cloud-native applications.
					</p>
					<p>
						Throughout my journey, I have collaborated closely with business stakeholders to transition MVPs into high-performance production systems, while actively mentoring team members, leading code reviews, and driving DevOps best practices.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">

					<p>Bachelor of Engineering in Computer Science  </p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>Python, Django, FastAPI, AWS, React , Vue , Chainlit , langChain , Ollama ,llmStudio , llamaindex, Digitalocean , AWS , docker </p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
